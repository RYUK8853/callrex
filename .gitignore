# Build outputs
build/
*.apk
*.keystore
.gradle/
local.properties
.idea/
.DS_Store

# graphify knowledge-graph output (build artifact, not published)
graphify-out/

# internal build/planning notes (not published)
docs/superpowers/
.gstack/

# App signing keystore — the release identity; keep local, back up separately, NEVER commit.
# No trailing slash: a worktree reaches the keystore through a *symlink* named `signing`,
# which git treats as a file, so `/signing/` would match the real directory but not the link.
/signing

# Native (CMake/NDK) build cache
.cxx/
app/.cxx/
